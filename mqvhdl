#!/usr/bin/env bash

set -e

VERSION="0.2.0"
CONFIG_FILE=".mqvhdl"

# ─────────────────────────────────────────────
# Colors
# ─────────────────────────────────────────────

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
RESET='\033[0m'

info() {
    echo -e "${BLUE}→${RESET} $1"
}

success() {
    echo -e "${GREEN}✓${RESET} $1"
}

warn() {
    echo -e "${YELLOW}!${RESET} $1"
}

error() {
    echo -e "${RED}✗${RESET} $1" >&2
}

# ─────────────────────────────────────────────
# General helpers
# ─────────────────────────────────────────────

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

require_command() {
    if ! command_exists "$1"; then
        error "Required command not found: $1"
        exit 1
    fi
}

require_project() {
    if [[ ! -f "$CONFIG_FILE" ]]; then
        error "No $CONFIG_FILE found."
        echo
        echo "Run 'mqvhdl init' first."
        exit 1
    fi
}

get_config_value() {
    local key="$1"

    grep "^${key}=" "$CONFIG_FILE" | head -n 1 | cut -d '=' -f 2-
}

# ─────────────────────────────────────────────
# Project configuration
# ─────────────────────────────────────────────

load_config() {
    SOURCE_DIR="$(get_config_value "source_dir")"
    TESTBENCH_DIR="$(get_config_value "testbench_dir")"

    if [[ -z "$SOURCE_DIR" || -z "$TESTBENCH_DIR" ]]; then
        error "Invalid $CONFIG_FILE"
        echo
        echo "Expected:"
        echo "  source_dir=src"
        echo "  testbench_dir=tb"
        exit 1
    fi
}

# ─────────────────────────────────────────────
# Entity discovery
# ─────────────────────────────────────────────

discover_entities() {
    local directory="$1"

    [[ -d "$directory" ]] || return 0

    while IFS= read -r -d '' file; do
        grep -Eio '^[[:space:]]*entity[[:space:]]+[a-zA-Z_][a-zA-Z0-9_]*' "$file" \
            | sed -E 's/^[[:space:]]*entity[[:space:]]+//I' \
            | while IFS= read -r entity; do
                echo "$entity|$file"
            done
    done < <(find "$directory" -type f \( -iname "*.vhd" -o -iname "*.vhdl" \) -print0 | sort -z)
}

find_entity_file() {
    local requested_entity="$1"
    local directory="$2"

    local requested_lower
    requested_lower="$(echo "$requested_entity" | tr '[:upper:]' '[:lower:]')"

    while IFS='|' read -r entity file; do
        local entity_lower
        entity_lower="$(echo "$entity" | tr '[:upper:]' '[:lower:]')"

        if [[ "$entity_lower" == "$requested_lower" ]]; then
            echo "$file"
            return 0
        fi
    done < <(discover_entities "$directory")

    return 1
}

# ─────────────────────────────────────────────
# Dependency checks
# ─────────────────────────────────────────────

check_build_dependencies() {
    require_command ghdl
}

check_run_dependencies() {
    require_command ghdl
    require_command gtkwave
}

# ─────────────────────────────────────────────
# init
# ─────────────────────────────────────────────

init_project() {
    local source_dir="src"
    local testbench_dir="tb"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -s|--source-dir)
                [[ -n "${2:-}" ]] || {
                    error "Missing value for $1"
                    exit 1
                }
                source_dir="$2"
                shift 2
                ;;

            -t|--testbench-dir)
                [[ -n "${2:-}" ]] || {
                    error "Missing value for $1"
                    exit 1
                }
                testbench_dir="$2"
                shift 2
                ;;

            -h|--help)
                echo "Usage: mqvhdl init [options]"
                echo
                echo "Options:"
                echo "    -s, --source-dir <dir>       Source directory (default: src)"
                echo "    -t, --testbench-dir <dir>   Testbench directory (default: tb)"
                exit 0
                ;;

            *)
                error "Unknown init option: $1"
                exit 1
                ;;
        esac
    done

    if [[ -f "$CONFIG_FILE" ]]; then
        error "$CONFIG_FILE already exists."
        echo
        echo "Project is already initialized."
        exit 1
    fi

    mkdir -p "$source_dir"
    mkdir -p "$testbench_dir"

    cat > "$CONFIG_FILE" <<CONFIG
source_dir=$source_dir
testbench_dir=$testbench_dir
CONFIG

    success "Project initialized."
    echo
    echo "  Configuration : $CONFIG_FILE"
    echo "  Source        : $source_dir/"
    echo "  Testbenches   : $testbench_dir/"
}

# ─────────────────────────────────────────────
# list
# ─────────────────────────────────────────────

list_project() {
    require_project
    load_config

    echo
    echo -e "${CYAN}mqvhdl project${RESET}"
    echo "────────────────────────────────────────"
    echo "Source directory     : $SOURCE_DIR/"
    echo "Testbench directory  : $TESTBENCH_DIR/"
    echo

    echo -e "${CYAN}Source entities${RESET}"
    echo "────────────────────────────────────────"

    local source_found=false

    while IFS='|' read -r entity file; do
        source_found=true
        echo "  • $entity"
        echo "    └─ $file"
    done < <(discover_entities "$SOURCE_DIR")

    if [[ "$source_found" == false ]]; then
        echo "  (none found)"
    fi

    echo
    echo -e "${CYAN}Testbench entities${RESET}"
    echo "────────────────────────────────────────"

    local tb_found=false

    while IFS='|' read -r entity file; do
        tb_found=true
        echo "  • $entity"
        echo "    └─ $file"
    done < <(discover_entities "$TESTBENCH_DIR")

    if [[ "$tb_found" == false ]]; then
        echo "  (none found)"
    fi

    echo
}

# ─────────────────────────────────────────────
# build
# ─────────────────────────────────────────────

build_project() {
    require_project
    check_build_dependencies
    load_config

    local analyze_only=false
    local elaborate=false
    local testbench=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -a|--analyze)
                analyze_only=true
                shift
                ;;

            -e|--elaborate)
                elaborate=true
                shift
                ;;

            -t|--tb)
                [[ -n "${2:-}" ]] || {
                    error "Missing testbench entity."
                    exit 1
                }
                testbench="$2"
                shift 2
                ;;

            -h|--help)
                echo "Usage: mqvhdl build [options]"
                echo
                echo "Options:"
                echo "    -a, --analyze       Analyze only"
                echo "    -e, --elaborate    Elaborate a testbench"
                echo "    -t, --tb <entity>  Testbench entity to elaborate"
                exit 0
                ;;

            *)
                error "Unknown build option: $1"
                exit 1
                ;;
        esac
    done

    if [[ "$analyze_only" == true && "$elaborate" == true ]]; then
        error "Cannot use --analyze and --elaborate together."
        exit 1
    fi

    echo
    echo -e "${CYAN}Building project${RESET}"
    echo "────────────────────────────────────────"

    local source_files=()
    local tb_files=()

    while IFS= read -r -d '' file; do
        source_files+=("$file")
    done < <(
        find "$SOURCE_DIR" -type f \
            \( -iname "*.vhd" -o -iname "*.vhdl" \) \
            -print0 | sort -z
    )

    while IFS= read -r -d '' file; do
        tb_files+=("$file")
    done < <(
        find "$TESTBENCH_DIR" -type f \
            \( -iname "*.vhd" -o -iname "*.vhdl" \) \
            -print0 | sort -z
    )

    if [[ ${#source_files[@]} -eq 0 ]]; then
        warn "No VHDL source files found in $SOURCE_DIR/"
    fi

    if [[ ${#tb_files[@]} -eq 0 ]]; then
        warn "No VHDL testbench files found in $TESTBENCH_DIR/"
    fi

    # Analyze source files
    for file in "${source_files[@]}"; do
        info "Analyzing source: $file"
        ghdl -a "$file"
        success "Source analyzed: $file"
    done

    # Analyze testbenches
    for file in "${tb_files[@]}"; do
        info "Analyzing testbench: $file"
        ghdl -a "$file"
        success "Testbench analyzed: $file"
    done

    if [[ "$analyze_only" == true ]]; then
        echo
        success "Analysis complete."
        return 0
    fi

    if [[ "$elaborate" == true ]]; then
        if [[ -z "$testbench" ]]; then
            error "--elaborate requires --tb <entity>"
            exit 1
        fi

        if ! find_entity_file "$testbench" "$TESTBENCH_DIR" >/dev/null; then
            error "Testbench entity not found: $testbench"
            echo
            echo "Run 'mqvhdl list' to see available testbenches."
            exit 1
        fi

        echo
        info "Elaborating: $testbench"
        ghdl -e "$testbench"
        success "Elaboration complete: $testbench"
    fi

    echo
    success "Build complete."
}

# ─────────────────────────────────────────────
# run
# ─────────────────────────────────────────────

run_simulation() {
    require_project
    check_run_dependencies
    load_config

    local testbench=""
    local output=""
    local generate_wave=true

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -t|--tb)
                [[ -n "${2:-}" ]] || {
                    error "Missing testbench entity."
                    exit 1
                }
                testbench="$2"
                shift 2
                ;;

            -o|--output)
                [[ -n "${2:-}" ]] || {
                    error "Missing waveform name."
                    exit 1
                }
                output="$2"
                shift 2
                ;;

            -g|--ghw)
                generate_wave=true
                shift
                ;;

            --no-wave)
                generate_wave=false
                shift
                ;;

            -h|--help)
                echo "Usage: mqvhdl run --tb <entity> [options]"
                echo
                echo "Options:"
                echo "    -t, --tb <entity>  Testbench entity"
                echo "    -o, --output <name> Waveform name"
                echo "    -g, --ghw          Generate GHW waveform"
                echo "    --no-wave          Do not generate waveform"
                exit 0
                ;;

            *)
                error "Unknown run option: $1"
                exit 1
                ;;
        esac
    done

    if [[ -z "$testbench" ]]; then
        local testbenches=()

        while IFS='|' read -r entity file; do
            testbenches+=("$entity")
        done < <(discover_entities "$TESTBENCH_DIR")

        if [[ ${#testbenches[@]} -eq 0 ]]; then
            error "No testbench entities found."
            exit 1
        elif [[ ${#testbenches[@]} -eq 1 ]]; then
            testbench="${testbenches[0]}"
            info "Using testbench: $testbench"
        else
            error "Multiple testbenches found. Specify one with --tb."
            echo
            echo "Available testbenches:"
            for tb in "${testbenches[@]}"; do
                echo "  • $tb"
            done
            exit 1
        fi
    fi

    if ! find_entity_file "$testbench" "$TESTBENCH_DIR" >/dev/null; then
        error "Testbench entity not found: $testbench"
        echo
        echo "Run 'mqvhdl list' to see available testbenches."
        exit 1
    fi

    # Build before simulation
    build_project

    echo
    info "Elaborating: $testbench"
    ghdl -e "$testbench"
    success "Elaboration complete."

    echo
    info "Running simulation: $testbench"

    if [[ "$generate_wave" == true ]]; then
        if [[ -z "$output" ]]; then
            output="$testbench"
        fi

        local waveform="${output}.ghw"

        ghdl -r "$testbench" --wave="$waveform"

        success "Waveform generated: $waveform"

        echo
        info "Opening GTKWave"
        gtkwave "$waveform" >/dev/null 2>&1 &
        success "GTKWave started."
    else
        ghdl -r "$testbench"
        success "Simulation complete."
    fi
}

# ─────────────────────────────────────────────
# clean
# ─────────────────────────────────────────────

clean_project() {
    info "Removing generated files..."

    find . -type f \
        \( -name "*.cf" \
        -o -name "*.ghw" \
        -o -name "*.vcd" \
        -o -name "*.gtkw" \) \
        -delete

    success "Clean complete."
}

# ─────────────────────────────────────────────
# help
# ─────────────────────────────────────────────

show_help() {
    cat <<HELP
mqvhdl ${VERSION}

A small VHDL project workflow tool built around GHDL and GTKWave.

Usage:
    mqvhdl <command> [options]

Commands:
    init        Initialize a VHDL project
    build       Analyze and optionally elaborate the project
    run         Run a testbench simulation
    list        List discovered entities and testbenches
    clean       Remove generated files
    help        Show this help message

Examples:
    mqvhdl init

    mqvhdl init -s rtl -t verification

    mqvhdl list

    mqvhdl build

    mqvhdl build --analyze

    mqvhdl build --elaborate --tb and_gate_tb

    mqvhdl run --tb and_gate_tb

    mqvhdl run --tb and_gate_tb --output and_gate

    mqvhdl clean

Version:
    mqvhdl ${VERSION}
HELP
}

show_version() {
    echo "mqvhdl ${VERSION}"
}

# ─────────────────────────────────────────────
# Main
# ─────────────────────────────────────────────

case "${1:-}" in

    init)
        shift
        init_project "$@"
        ;;

    build)
        shift
        build_project "$@"
        ;;

    run)
        shift
        run_simulation "$@"
        ;;

    list)
        shift
        list_project "$@"
        ;;

    clean)
        shift
        clean_project "$@"
        ;;

    help|-h|--help)
        show_help
        ;;

    --version|-v)
        show_version
        ;;

    "")
        show_help
        ;;

    *)
        error "Unknown command: $1"
        echo "Use 'mqvhdl help'."
        exit 1
        ;;

esac
