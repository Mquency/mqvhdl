How builds work:
  * mqvhdl parses entities, packages, configurations, contexts,
    architectures and instantiations to build a dependency graph.
  * Only the files needed by the selected testbench(es) are analyzed,
    in dependency order (chained dependencies are handled).
  * A file is re-analyzed only when its content, one of its dependencies,
    the GHDL version or the analysis options change — everything else is
    reused from the cache.

Run 'mqvhdl <command> --help' for command options.

Examples:
  mqvhdl init
  mqvhdl init -s rtl -t verification --std 08
  mqvhdl list
  mqvhdl build
  mqvhdl build --tb and_gate_tb
  mqvhdl build --elaborate --tb and_gate_tb
  mqvhdl run
  mqvhdl run --tb and_gate_tb --output and_gate
  mqvhdl clean

Version:
  mqvhdl ${VERSION}
HELP
}

# ─────────────────────────────────────────────
# Main
# ─────────────────────────────────────────────

on_exit() {
  local code=$?
  release_instance_lock
  finish_timer "$code"
}

main() {
  require_bash
  setup_hash
  trap on_exit EXIT

  local cmd="${1:-}"
  if [[ $# -gt 0 ]]; then shift; fi

  case "$cmd" in
    init)   COMMAND_NAME="init";  start_timer; init_project "$@" ;;
    list)   COMMAND_NAME="list";  start_timer; list_project "$@" ;;
    build)  COMMAND_NAME="build"; start_timer; build_project "$@" ;;
    run)    COMMAND_NAME="run";   start_timer; run_simulation "$@" ;;
    clean)  COMMAND_NAME="clean"; start_timer; clean_project "$@" ;;
    help|-h|--help) show_help ;;
    --version|-v) show_version ;;
    "") show_help ;;
    *)
      error "Unknown command: $cmd"
      hint "Run 'mqvhdl help' to list commands."
      exit 1
      ;;
  esac
}

main "$@"
